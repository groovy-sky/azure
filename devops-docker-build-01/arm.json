{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]"
        },
        "containerImage": {
            "type": "string",
            "defaultValue": "ghcr.io/groovy-sky/devops-agent:latest"
        },
        "azpUrl": {
            "type": "string"
        },
        "azpPool": {
            "type": "string",
            "defaultValue": "Default"
        },
        "azpToken": {
            "type": "secureString",
            "defaultValue": ""
        },
        "targetPipelinesQueueLength": {
            "type": "string",
            "defaultValue": "1"
        },

        "triggerType": {
            "type": "string",
            "defaultValue": "Event",
            "allowedValues": ["Event"]
        },
        "parallelism": {
            "type": "int",
            "defaultValue": 1
        },
        "minExecutions": {
            "type": "int",
            "defaultValue": 0
        },
        "maxExecutions": {
            "type": "int",
            "defaultValue": 1
        },
        "publicNetworkAccess": {
            "type": "string",
            "defaultValue": "Enabled",
            "allowedValues": ["Enabled", "Disabled"]
        },
        "workloadProfileType": {
            "type": "string",
            "defaultValue": "Consumption",
            "allowedValues": ["Consumption"]
        },
        "containerMemory": {
            "type": "string",
            "defaultValue": "2.0Gi",
            "allowedValues": ["0.5Gi", "1.0Gi", "1.5Gi", "2.0Gi", "2.5Gi", "3.0Gi", "3.5Gi", "4.0Gi", "4.5Gi", "5.0Gi", "5.5Gi", "6.0Gi", "6.5Gi", "7.0Gi", "7.5Gi", "8.0Gi"]
        }
    },
    "variables": {
        "jobName": "[concat('azdo-agent-job-', uniqueString(resourceGroup().name))]",
        "environmentName": "[concat('aca-azdo-env-', uniqueString(resourceGroup().name))]",
        "profileName": "Consumption",
        "memoryCpuMap": {
            "0.5Gi": 0.25,
            "1.0Gi": 0.5,
            "1.5Gi": 0.75,
            "2.0Gi": 1.0,
            "2.5Gi": 1.25,
            "3.0Gi": 1.5,
            "3.5Gi": 1.75,
            "4.0Gi": 2.0,
            "4.5Gi": 2.25,
            "5.0Gi": 2.5,
            "5.5Gi": 2.75,
            "6.0Gi": 3.0,
            "6.5Gi": 3.25,
            "7.0Gi": 3.5,
            "7.5Gi": 3.75,
            "8.0Gi": 4.0
        },
        "containerCpu": "[variables('memoryCpuMap')[parameters('containerMemory')]]"
    },
    "resources": [
        {
            "type": "Microsoft.App/managedEnvironments",
            "apiVersion": "2026-01-01",
            "name": "[variables('environmentName')]",
            "location": "[parameters('location')]",
            "properties": {
                "zoneRedundant": false,
                "kedaConfiguration": {},
                "daprConfiguration": {},
                "customDomainConfiguration": {},
                "workloadProfiles": [
                    {
                        "workloadProfileType": "[parameters('workloadProfileType')]",
                        "name": "[variables('profileName')]"
                    }
                ],
                "peerAuthentication": {
                    "mtls": {
                        "enabled": false
                    }
                },
                "peerTrafficConfiguration": {
                    "encryption": {
                        "enabled": false
                    }
                },
                "publicNetworkAccess": "[parameters('publicNetworkAccess')]"
            }
        },
        {
            "type": "Microsoft.App/jobs",
            "apiVersion": "2026-01-01",
            "name": "[variables('jobName')]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]"
            ],
            "identity": {
                "type": "None"
            },
            "properties": {
                "environmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
                "workloadProfileName": "[variables('profileName')]",
                "configuration": {
                    "secrets": [
                        {
                            "name": "azp-token",
                            "value": "[parameters('azpToken')]"
                        }
                    ],
                    "triggerType": "[parameters('triggerType')]",
                    "replicaTimeout": 1800,
                    "replicaRetryLimit": 1,
                    "eventTriggerConfig": {
                        "replicaCompletionCount": 1,
                        "parallelism": "[parameters('parallelism')]",
                        "scale": {
                            "minExecutions": "[parameters('minExecutions')]",
                            "maxExecutions": "[parameters('maxExecutions')]",
                            "pollingInterval": 30,
                            "rules": [
                                {
                                    "name": "azure-pipelines-scaler",
                                    "type": "azure-pipelines",
                                    "metadata": {
                                        "organizationURLFromEnv": "AZP_URL",
                                        "personalAccessTokenFromEnv": "AZP_TOKEN",
                                        "poolName": "[parameters('azpPool')]",
                                        "targetPipelinesQueueLength": "[parameters('targetPipelinesQueueLength')]"
                                    }
                                }
                            ]
                        }
                    },
                    "identitySettings": []
                },
                "template": {
                    "containers": [
                        {
                            "image": "[parameters('containerImage')]",
                            "name": "[variables('jobName')]",
                            "command": [],
                            "args": [],
                            "env": [
                                {
                                    "name": "AZP_URL",
                                    "value": "[parameters('azpUrl')]"
                                },
                                {
                                    "name": "AZP_POOL",
                                    "value": "[parameters('azpPool')]"
                                },
                                {
                                    "name": "AZP_TOKEN",
                                    "secretRef": "azp-token"
                                },
                                {
                                    "name": "AZP_AGENT_NAME",
                                    "value": "[variables('jobName')]"
                                },
                                {
                                    "name": "AZP_AGENT_ONCE",
                                    "value": "true"
                                }
                            ],
                            "resources": {
                                "cpu": "[variables('containerCpu')]",
                                "memory": "[parameters('containerMemory')]"
                            },
                            "probes": []
                        }
                    ]
                }
            }
        }
    ]
}