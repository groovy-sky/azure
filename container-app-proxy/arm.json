{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "image": {
      "type": "string",
      "defaultValue": "mcr.microsoft.com/azuredocs/aci-helloworld"
    },
    "proxyImage": {
      "type": "string",
      "defaultValue": "docker.io/gr00vysky/container-app-proxy:latest",
      "metadata": {
        "description": "Container image for the Go proxy built from container-app-proxy/."
      }
    },
    "port": {
      "type": "int",
      "defaultValue": 80
    },
    "proxyPort": {
      "type": "int",
      "defaultValue": 8080
    }
  },
  "variables": {
    "location": "[resourceGroup().location]",
    "prefix": "[concat('caproxy-', uniqueString(subscription().subscriptionId, resourceGroup().name))]",
    "vnetName": "[concat(variables('prefix'), '-vnet')]",
    "aciSubnetName": "[concat(variables('prefix'), '-aci-subnet')]",
    "acaSubnetName": "[concat(variables('prefix'), '-aca-subnet')]",
    "containerGroupName": "[concat(variables('prefix'), '-aci')]",
    "containerName": "[concat(variables('prefix'), '-proxy')]",
    "managedEnvironmentName": "[concat(variables('prefix'), '-aca-env')]",
    "containerAppName": "[concat(variables('prefix'), '-app')]",
    "aciContributorRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '5d977122-f97e-4b4d-a52f-6b43003ddb4d')]",
    "vnetAddress": "10.10.0.0/24",
    "aciSubnetPrefix": "10.10.0.0/25",
    "acaSubnetPrefix": "10.10.0.128/25"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-05-01",
      "name": "[variables('vnetName')]",
      "location": "[variables('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[variables('vnetAddress')]"
          ]
        },
        "subnets": [
          {
            "name": "[variables('aciSubnetName')]",
            "properties": {
              "addressPrefix": "[variables('aciSubnetPrefix')]",
              "delegations": [
                {
                  "name": "aciDelegation",
                  "properties": {
                    "serviceName": "Microsoft.ContainerInstance/containerGroups"
                  }
                }
              ]
            }
          },
          {
            "name": "[variables('acaSubnetName')]",
            "properties": {
              "addressPrefix": "[variables('acaSubnetPrefix')]",
              "delegations": [
                {
                  "name": "acaDelegation",
                  "properties": {
                    "serviceName": "Microsoft.App/environments"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.ContainerInstance/containerGroups",
      "apiVersion": "2023-05-01",
      "name": "[variables('containerGroupName')]",
      "location": "[variables('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ],
      "properties": {
        "osType": "Linux",
        "restartPolicy": "Always",
        "ipAddress": {
          "type": "Private",
          "ports": [
            {
              "protocol": "TCP",
              "port": "[parameters('port')]"
            }
          ]
        },
        "subnetIds": [
          {
            "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('aciSubnetName'))]"
          }
        ],
        "containers": [
          {
            "name": "[variables('containerName')]",
            "properties": {
              "image": "[parameters('image')]",
              "ports": [
                {
                  "port": "[parameters('port')]"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": 1,
                  "memoryInGB": 1
                }
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2023-05-01",
      "name": "[variables('managedEnvironmentName')]",
      "location": "[variables('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ],
      "properties": {
        "vnetConfiguration": {
          "infrastructureSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('acaSubnetName'))]"
        }
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-01",
      "name": "[variables('containerAppName')]",
      "location": "[variables('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('managedEnvironmentName'))]",
        "[resourceId('Microsoft.ContainerInstance/containerGroups', variables('containerGroupName'))]"
      ],
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('managedEnvironmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "allowInsecure": true,
            "targetPort": "[parameters('proxyPort')]",
            "transport": "http",
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ]
          }
        },
        "template": {
          "containers": [
            {
              "name": "proxy",
              "image": "[parameters('proxyImage')]",
              "env": [
                {
                  "name": "HTTP_PORT",
                  "value": "[string(parameters('proxyPort'))]"
                }
              ],
              "resources": {
                "cpu": 0.25,
                "memory": "0.5Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 1
          }
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.App/containerApps', variables('containerAppName')), variables('aciContributorRoleId'))]" ,
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', variables('containerAppName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('aciContributorRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.App/containerApps', variables('containerAppName')), '2023-05-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "prefix": {
      "type": "string",
      "value": "[variables('prefix')]"
    },
    "vnetName": {
      "type": "string",
      "value": "[variables('vnetName')]"
    },
    "containerGroupName": {
      "type": "string",
      "value": "[variables('containerGroupName')]"
    },
    "containerInstancePrivateIp": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerInstance/containerGroups', variables('containerGroupName')), '2023-05-01').ipAddress.ip]"
    },
    "managedEnvironmentName": {
      "type": "string",
      "value": "[variables('managedEnvironmentName')]"
    },
    "containerAppName": {
      "type": "string",
      "value": "[variables('containerAppName')]"
    }
  }
}